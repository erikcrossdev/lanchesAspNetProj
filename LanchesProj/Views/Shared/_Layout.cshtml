<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - LanchesProj</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/LanchesProj.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column h-100 bg-light">
	<header>
		<!-- Vamos usar o bootstrap com texto light e fundo light-->
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
			<div class="container">
				<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
					<div class="d-flex align-items-center gap-2">
						<img src="~/images/burger.png" height="50" />
						<span>LanchesProj</span>
					</div>
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
					@await Component.InvokeAsync("CarrinhoCompraResumo")
					@await Component.InvokeAsync("CategoriaMenu")
					<a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
					<a class="nav-link text-light" asp-area="" asp-controller="Contato" asp-action="Index">Contato</a>
					<form class="navbar-form navbar-right" asp-controller="Lanche" asp-action="Search" method="get">
						<div class="form-group">
							<input type="text" name="searchString" class="form-control" placeholder="Pesquisar Lanches..." value="@ViewData["searchString"]">
						</div>
					</form>
					@await Html.PartialAsync("_LoginPartial")
					@if (User.IsInRole("Admin"))
					{
						<a class="nav-link text-light" asp-area="Admin" asp-controller="Admin" asp-action="Index">Admin</a>
					}
				</div>
			</div>
		</nav>
	</header>

	<!-- Adicionamos 'flex-fill' para o container ocupar o espaço livre e empurrar o footer -->
	<div class="container flex-fill">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)

	<partial name="_Footer" />
</body>
</html>
