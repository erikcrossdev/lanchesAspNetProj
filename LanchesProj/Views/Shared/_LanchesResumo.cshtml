@model Lanche

<div class="col-sm-4 col-md-4 col-lg-4">
	<p><img src="@Model.ImagemUrl" class="img-fluid" /></p>
	<h4>
		<a asp-controller="Lanche" asp-action="Details" asp-route-lancheId="@Model.LancheId">@Model.Nome</a>
	</h4>
	<h6>Preço: @Model.Preco.ToString("C")</h6>
	<p>Descrição: <br />@Model.DescricaoCurta</p>
	<div>
		<p class="button">
			<a class="btn btn-primary" id="cartButton" asp-controller="CarrinhoCompra" asp-action="AdicionarItemNoCarrinhoCompra" asp-route-LancheId="@Model.LancheId">
				<img src="~/images/cart-white.png" height="35" />&nbsp;Incluir no Carrinho
			</a>
		</p>
	</div>
</div>