@model Pedido

<div class="container">
	<div class="p-5 mb-4 bg-light rounded-3">
		<!--Jombotron foi descontinuado-->
		<div class="container-fluid py-5">
			<h2 class="display-5 fw-bold">@ViewBag.CheckoutCompletoMensagem</h2>
		</div>
	</div>

	<div class="card">
		<div class="card-body">
			<p> Cliente: <strong>@Model.Nome</strong></p>
			<p> Data do pedido: <strong>@Model.PedidoEnviado</strong></p>
			<p> Número do pedido: <strong>@Model.PedidoId</strong></p>

			<table class="table">
				<tr>
					<th></th>
					<th>Quantidade</th>
					<th>Lanche</th>
					<th>Preço</th>
				</tr>
				@foreach(var item in Model.PedidoItens)
				{
					<tr>
						<td><img src="@item.Lanche.ImagemUrl" height="40" /></td>
						<td>@item.Quantidade</td>
						<td>@item.Lanche.Nome</td>
						<td>@item.Lanche.Preco</td>
					</tr>
				}
			</table>
			<h4>Valor Total do Pedido: <strong>@(((decimal)ViewBag.TotalPedido).ToString("C2"))</strong></h4>
		</div>
	</div>

</div>
<div class="form-group" style="text-align: center">
	<h3>
		<a class="nav-link text-info" asp-controller="Home" asp-action="Index">Retornar</a>
	</h3>
</div>