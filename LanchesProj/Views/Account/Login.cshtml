@model LoginViewModel

<table class="table">
	<tr>
		<td>
			<img src="~/images/login.png" height="180" alt="Faça seu login" class="center-block" />
		</td>
		<td>
			<div class="row">
				<div class="col-10 col-md-10 col-lg-10">
					<h4>Login</h4>
					<form asp-controller="Account" asp-action="Login" method="post" class="form-horizontal" role="form">
						<hr />
						<div asp-validation-summary="All" class="text-danger"></div> <!-- mensagem de erro geral-->
						<input type="hidden" asp-for="ReturnUrl" />
						<!--username group-->
						<div class="form-group">
							<label asp-for="Username" class="col-md-2 control-label"></label>
							<div class="col-md-6">
								<input asp-for="Username" class="form-control" />
								<span asp-validation-for="Username" class="text-danger"></span> <!-- mensagem de erro para o username-->
							</div>
						</div>
						<!--password group-->
						<div class="form-group">
							<label asp-for="Password" class="col-md-2 control-label"></label>
							<div class="col-md-6">
								<input asp-for="Password" class="form-control" />
								<span asp-validation-for="Password" class="text-danger"></span><!-- mensagem de erro para o username-->
							</div>
						</div>
						<br />
						<!--button group-->
						<div class="form-group">
							<div class="col-md-8">
								<input type="submit" class="btn btn-success" value="Log in"/>
							</div>
						</div>
					</form>
				</div>
			</div>
		</td>
	</tr>
</table>