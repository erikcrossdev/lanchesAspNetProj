@model LancheListViewModel;

	<div>
		<h2>@Model.CategoriaAtual</h2>
	</div>

	<!--h2>@ViewData["Data"]</h2>-->
	<hr />

	<p>@ViewBag.Total @ViewBag.TotalLanches</p>
	<hr />
	@if (TempData.ContainsKey("Mensagem"))
	{
		//<p>@TempData["Mensagem"]</p>
	}

	<div class="container">
		<div class="row">
		@foreach(var lanche in Model.Lanches)
		{
		//img-luid deixa a imagem mais fluída
			<div class="col-sm-4 col-md-4 col-lg-4">
				<p><img src="@lanche.ImagemUrl" class="img-fluid"/></p> 
				<h4>@lanche.Nome</h4>
				<h3>Preço: @lanche.Preco.ToString("C")</h3>
				<p>Descrição: <br />@lanche.DescricaoCurta</p>
			</div>
		}
	</div>
</div>