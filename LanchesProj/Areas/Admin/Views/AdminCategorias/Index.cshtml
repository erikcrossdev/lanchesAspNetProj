@model IEnumerable<LanchesProj.Models.Categoria>

@{
    ViewData["Title"] = "Index";
}

<h1>Categorias</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm mb-1 d-block">Criar Nova Categoria</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoriaNome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoriaNome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descricao)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CategoriaId" class="btn btn-warning btn-sm mb-1 d-block">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.CategoriaId" class="btn btn-secondary btn-sm mb-1 d-block">Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@item.CategoriaId" class="btn btn-danger btn-sm d-block">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
