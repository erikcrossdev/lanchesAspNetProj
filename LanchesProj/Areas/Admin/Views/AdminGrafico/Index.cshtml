<title>
	@ViewData["Title"] - Grafico de Vendas
</title>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

<div id="chart_div" style="width: 900px; height: 500px;"></div>

<script type="text/javascript">
	// 1. Carrega a biblioteca do Google Charts
	google.charts.load('current', { packages: ['corechart'] });

	// 2. Define o callback que será executado assim que a biblioteca carregar
	google.charts.setOnLoadCallback(CarregarDados);

	function CarregarDados() {
		$.ajax({
			url: '@Url.Action("VendasLanches", "AdminGrafico")',
			data: { dias: 360 },
			dataType: "json",
			type: "GET",
			error: function (xhr, status, error) {
				console.error(xhr.responseText);
				toastr.error("Erro ao carregar dados do gráfico.");
			},
			success: function (resultado) {
				// Assim que os dados chegam do AJAX, chamamos a função que desenha
				DesenharGrafico(resultado);
			}
		});
	}

	function DesenharGrafico(dadosJson) {
		if (!dadosJson || dadosJson.length === 0) {
			$('#chart_div').html('<p class="text-muted text-center p-4" style="padding-top: 200px;">Nenhum dado de venda encontrado para os últimos 30 dias.</p>');
			return;
		}

		var dataArray = [
			['Lanche', 'Quantidade', 'Valores (R$)']
		];

		$.each(dadosJson, function (i, item) {
			var nome = item.lancheNome || 'Sem Nome';

			// Multiplicando por 10 para ajustar a escala visual no gráfico de barras
			var quantidadeReal = parseInt(item.lanchesQuantidade) || 0;
			var quantidadeEscala = quantidadeReal;

			var valorTotal = parseFloat(item.lanchesValorTotal) || 0;

			dataArray.push([nome, quantidadeEscala, valorTotal]);
		});

		var tabelaDados = google.visualization.arrayToDataTable(dataArray);

		var options = {
			title: 'Lanches - Vendas dos últimos 360 dias',

			animation: {
                duration: 3000,
                easing: 'out',
                startup: true
            },

			curveType: 'function',
			legend: { position: 'bottom' }, //coloca a legenda em baixo
			chartArea: {
				width: '65%'
			},
			colors: ['#5202b5', '#d2a828'],
			series: {
				0: { targetAxisIndex: 0 },
				1: { targetAxisIndex: 1 }
			},
			hAxes: {
				0: { title: 'Quantidade', minValue: 0 },
				1: { title: 'Valor Total (R$)', minValue: 0 }
			}, 
			vAxis: {
				title: 'Lanches'
			}
		};

		var chart = new google.visualization.BarChart(document.getElementById('chart_div'));
		chart.draw(tabelaDados, options);
	}
</script>

