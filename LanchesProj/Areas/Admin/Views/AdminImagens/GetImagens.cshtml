@model FileManagerModel
@{
	ViewBag.Title = "Arquivos";
}

@if (Model.Files != null)
{
	<h4>Imagens:</h4>
	<hr />
	var caminho = Model.PathImagesProduto;

	<div class="d-flex flex-wrap gap-3 align-items-start">
		@foreach(FileInfo file in Model.Files)
		{
			<div class="d-flex flex-column align-items-center border p-3 rounded bg-light">
				<img src="~/@caminho/@file.Name" height="200" />
				<div style="padding:10px; text-align:center">
					<a href="@Url.Action("Deletefile", "AdminImagens", new {fname = file.Name})" class="btn btn-primary btn-sm d-block">Deletar</a>
				</div>
			</div>		
		}
	</div>
	<a href="@Url.Action("index", "AdminImagens")">Voltar para Gerenciamento de imagens</a>
}
<div class="container">
	<ul>
		@if (ViewData["Deletado"] != null)
		{
			<li>@ViewData["Deletado"]</li>
		}
	</ul>
</div>