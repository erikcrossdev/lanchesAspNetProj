@model ReflectionIT.Mvc.Paging.PagingList<LanchesProj.Models.Lanche>

@{
	ViewData["Title"] = "Index";
}

<h1>Lanches</h1>
<!--adiciona barra de pesquisa-->
<form method="get" class="form-inline">
	<input name="filter" class="form-control" placeholder="filtro" value="@Model.RouteValue["Filter"]" />
	<br />
	<button type="submit" class="btn btn-info">
		<span class="glyphicon glyphicon-search" aria-hidden="true"></span> Procurar
	</button>
</form>
<br />

<strong>Total de Lanches: </strong>@Model.TotalRecordCount
<div>
	<vc:pager paging-list="@Model"></vc:pager> <!--cria paginador-->
</div>

<br />
<div class="row">
	<div class="col-md-12">
		<a asp-action="Create" class="btn btn-primary">
			<span class="glyphicon glyphicon-plus" aria-hidden="false"></span> Criar lanches
		</a>
		<a asp-controller="AdminLanchesReport" asp-action="LanchesCategoriasReport" class="btn btn-info">
			<span class="glyphicon glyphicon-file" aria-hidden="false"></span>Gerar Relatório
		</a>
		<a asp-controller="AdminLanchesReport" asp-action="LanchesCategoriaPDF" class="btn btn-success">
			<span class="glyphicon glyphicon-download-alt" aria-hidden="false"></span>Baixar Relatório em PDF
		</a>
		<a asp-controller="AdminLanchesReport" asp-action="LanchesCategoriaAbrePDF" target="_blank" class="btn btn-warning">
			<span class="glyphicon glyphicon-new-window" aria-hidden="false"></span> Abrir Relatório em PDF
		</a>
	</div>
</div>
<br />

<div class="row">
	<div class="col-md-15">

		<table class="table">
			<thead>
				<tr>
					<th>
						@Html.DisplayNameFor(model => model.Nome)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.DescricaoCurta)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.DescricaoDetalhada)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Preco)
					</th>
		
					<th>
						@Html.DisplayNameFor(model => model.IsLanchePreferido)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.EmEstoque)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Categoria)
					</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>
							@Html.DisplayFor(modelItem => item.Nome)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.DescricaoCurta)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.DescricaoDetalhada)
						</td>
						<td>
							@item.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
						</td>
						
						<td>
							@Html.DisplayFor(modelItem => item.IsLanchePreferido)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.EmEstoque)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.Categoria.CategoriaNome)
						</td>
						<td>
							<a asp-action="Edit" asp-route-id="@item.LancheId" class="btn btn-warning btn-sm mb-1 d-block">
								Editar
							</a> 
							<a asp-action="Details" asp-route-id="@item.LancheId" class="btn btn-secondary btn-sm mb-1 d-block">
								Detalhes
							</a>
							<a asp-action="Delete" asp-route-id="@item.LancheId" class="btn btn-danger btn-sm d-block">
								Deletar
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>